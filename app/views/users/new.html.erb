<div class="signup">
  <h2>Create Your Account</h2>
  <p>Join StayStories and share your journey.</p>

  <% if @user.errors.any? %>
    <div class="flash alert">
      <% @user.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @user, url: users_path do |f| %>
    <div class="mb-3">
      <%= f.label :name, "Username", class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :email_address, "Email Address", class: "form-label" %>
      <%= f.email_field :email_address, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :password, "Password", class: "form-label" %>
      <%= f.password_field :password, class: "form-control", required: true, minlength: 8 %>
    </div>

    <div class="mb-3">
      <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-control", required: true, minlength: 8 %>
    </div>

    <%= f.submit "Sign Up", class: "btn signup-btn" %>
  <% end %>
</div>