<main class="home">
  <section class="welcome">
    <div class="container">
      <div class="welcome-content">

        <p class="welcome-subtitle">EXPLORE • DISCOVER • SHARE</p>

        <h1>Every Journey Has a Story.</h1>

        <p class="welcome-description">
          Discover beautiful places, share your travel experiences,
          and inspire your next adventure with StayStories.
        </p>

        <div class="welcome-buttons">
          <%= link_to "Explore Stories", class: "explore-btn" %>
          <%= link_to "Share Your Story", new_post_path, class: "share-btn" %>
        </div>

      </div>
    </div>
  </section>
</main>