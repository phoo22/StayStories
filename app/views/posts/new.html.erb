<div class="container mt-4">
  <h1>New Post</h1>
  <p>Share your travel experience!</p>

  <% if @post.errors.any? %>
    <div class="alert alert-danger">
      <h5>Please fix the following errors:</h5>
      <ul class="mb-0">
        <% @post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @post, local: true do |f| %>

    <div class="mb-3">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :location, class: "form-label" %>
      <%= f.text_field :location, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :body, class: "form-label" %>
      <%= f.text_area :body, rows: 6, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :images, "Upload Photos", class: "form-label" %>
      <%= f.file_field :images,
          multiple: true,
          accept: "image/*",
          class: "form-control" %>
    </div>

    <%= f.submit "Create Post", class: "btn btn-primary" %>

  <% end %>
</div>
