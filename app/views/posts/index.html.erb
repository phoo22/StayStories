<div class="container mt-4">
  <h1>Stay Stories</h1>
  <h2>All Posts</h2>

  <% if @posts.any? %>
    <div class="row g-4 mt-2">
      <% @posts.each do |post| %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100">

            <% if post.images.attached? %>
              <%= image_tag post.images.first, class: "card-img-top", style: "height: 220px; object-fit: cover;" %>
            <% end %>

            <div class="card-body">
              <h4 class="card-title"><%= post.title %></h4>

              <p class="text-muted small mb-2">
                <i class="fa-solid fa-user"></i>
                Posted by <%= link_to post.user.name, user_path(post.user), class: "text-decoration-none" %>
              </p>

              <p class="text-muted">
                <i class="fa-solid fa-location-dot"></i>
                <%= post.location %>
              </p>

              <p class="card-text">
                <%= truncate(post.body, length: 100) %>
              </p>

              <%= link_to "Read More", post_path(post), class: "btn btn-primary" %>
            </div>

          </div>
        </div>
      <% end %>
    </div>

  <% else %>
    <p>No posts yet. Be the first to share your story!</p>
  <% end %>
</div>
